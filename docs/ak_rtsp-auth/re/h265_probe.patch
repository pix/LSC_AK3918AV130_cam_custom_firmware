diff --git i/firmware/src/ak_rtsp/venc.c w/firmware/src/ak_rtsp/venc.c
index c94a6ca..14f790b 100644
--- i/firmware/src/ak_rtsp/venc.c
+++ w/firmware/src/ak_rtsp/venc.c
@@ -104,7 +104,33 @@ static int vp_set(const char *v, const char **e)
     else { *e = "must be main or high (takes effect after a restart)"; return -1; }
     return 0;
 }
-static uint32_t venc_profile(void) { return s_vprofile ? H264_PROFILE_IDC_HIGH : H264_PROFILE_IDC_MAIN; }
+/* video.codec: h264 (default) or h265 (main stream only; the sub stream and
+ * snapshots are unaffected). Experimental: off by default. Crash guard: a
+ * marker is written before the HEVC encoder is created and removed once
+ * frames flow (venc_startup_ok). If the camera restarts with the marker
+ * still there, HEVC crashed or hung it, and every later start uses H.264
+ * until h265 is selected again (which clears the marker). */
+#define HEVC_GUARD "/etc/config/ak_rtsp_hevc_guard"
+static char g_venc_note[96];             /* defined with the stream settings below */
+static int s_vcodec;                      /* setting: 0 = h264, 1 = h265 */
+static int g_hevc;                        /* the encoder actually runs HEVC */
+static int g_hevc_guarded;
+static int vc_get(char *o, size_t c) { snprintf(o, c, "%s", s_vcodec ? "h265" : "h264"); return 0; }
+static int vc_set(const char *v, const char **e)
+{
+    if (!strcmp(v, "h264")) s_vcodec = 0;
+    else if (!strcmp(v, "h265")) {
+        if (!s_vcodec) unlink(HEVC_GUARD);   /* chosen again: allow a new attempt */
+        s_vcodec = 1;
+    } else { *e = "must be h264 or h265 (takes effect after a restart)"; return -1; }
+    return 0;
+}
+int venc_is_hevc(void) { return g_hevc; }
+static uint32_t venc_profile(void)
+{
+    if (g_hevc) return HEVC_PROFILE_MAIN;
+    return s_vprofile ? H264_PROFILE_IDC_HIGH : H264_PROFILE_IDC_MAIN;
+}
 
 static uint32_t venc_query_ring_pool_size(void)
 {
@@ -161,6 +187,20 @@ int venc_create_pool(void)
     char vp[8] = "";                          /* saved before settings are replayed */
     if (control_saved_get("video.profile", vp, sizeof vp) == 0) s_vprofile = !strcmp(vp, "high");
     if (s_vprofile) printf("[venc] H.264 High profile\n");
+    char vc[8] = "";
+    if (control_saved_get("video.codec", vc, sizeof vc) == 0 && !strcmp(vc, "h265")) {
+        s_vcodec = 1;                     /* so the settings replay does not clear the marker */
+        if (access(HEVC_GUARD, F_OK) == 0) {
+            snprintf(g_venc_note, sizeof g_venc_note,
+                     "H.265 did not start last time: using H.264 (choose H.264, then H.265 to retry)");
+            fprintf(stderr, "[venc] %s\n", g_venc_note);
+        } else {
+            int gfd = open(HEVC_GUARD, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+            if (gfd >= 0) { fsync(gfd); close(gfd); sync(); }
+            g_hevc = 1; g_hevc_guarded = 1;
+            printf("[venc] H.265 (HEVC Main) main stream, guarded\n");
+        }
+    }
 
     uint32_t ring_size = venc_query_ring_pool_size();
 
@@ -234,6 +274,7 @@ void venc_register_params(void)
     CTRL_REG("venc.kbps", p_kbps, CTRL_PERSIST);
     CTRL_REG("venc.gop", p_gop, CTRL_PERSIST);
     CTRL_REG("video.profile", vp, CTRL_PERSIST);
+    CTRL_REG("video.codec", vc, CTRL_PERSIST);
 }
 const char *venc_note(void) { return g_venc_note; }
 static int g_kbps_used = 1536, g_gop_used = ENC_GOP;
@@ -242,6 +283,7 @@ int venc_gop_now(void) { return g_gop_used; }
 void venc_startup_ok(void)
 {
     if (g_guarded) { unlink(VENC_GUARD); sync(); g_guarded = 0; }
+    if (g_hevc_guarded) { unlink(HEVC_GUARD); sync(); g_hevc_guarded = 0; printf("[venc] H.265 running: crash guard cleared\n"); }
 }
 
 int venc_create_encoder(void)
